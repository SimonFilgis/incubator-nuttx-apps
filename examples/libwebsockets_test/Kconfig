#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#


config EXAMPLES_LIBWEBSOCKETS_TEST
    tristate "libwebsockets test"
    default n
    depends on NETUTILS_LIBWEBSOCKETS
    ---help---
        Runs a minimal websocket client example using libwebsockets.

if EXAMPLES_LIBWEBSOCKETS_TEST

config EXAMPLES_LIBWEBSOCKETS_TEST_PROGNAME
	string "Program name"
	default "libwebsockets_test"
	---help---
		This is the name of the program that will be used when the NSH ELF
		program is installed.

config EXAMPLES_LIBWEBSOCKETS_TEST_PRIORITY
	int "Libwebsockets_test task priority"
	default 100

config EXAMPLES_LIBWEBSOCKETS_TEST_STACKSIZE
	int "Libwebsockets_test stack size"
	default 4000


endif




